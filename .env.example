# LiveKit Credentials
LIVEKIT_URL=wss://your-livekit-server.com
LIVEKIT_HOST=wss://your-livekit-server.com
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
LIVEKIT_AGENT_NAME=voice-agent
LIVEKIT_SIP_URI=sip:your-livekit-sip-uri

# Public HTTPS origin used to build Twilio callback URLs
PUBLIC_BASE_URL=https://your-domain.com

# Cognitive Providers
DEEPGRAM_API_KEY=your-deepgram-api-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_VOICE_ID=your-voice-id

# Databases and Cache
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_booking?schema=public

# Temporal Settings
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Observability
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Security
JWT_PRIVATE_KEY=your-jwt-private-key-base64
JWT_PUBLIC_KEY=your-jwt-public-key-base64

# Worker Tuning
MAX_CONCURRENT_JOBS=10
DEFAULT_TENANT_ID=your-default-tenant-uuid

# Target Calendar ID (Your actual email, e.g. your-email@gmail.com). 
# Do NOT use 'primary' unless you want events saved to the Service Account's hidden calendar.
TARGET_CALENDAR_ID=your-email@example.com

# Twilio Integration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_DEFAULT_TENANT_ID=your-default-tenant-uuid
TWILIO_PSTN_NUMBERS=+15551234567,+15557654321
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_BASE_URL=https://your-domain.com
TWILIO_SIP_STATUS_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/twilio
TWILIO_WHATSAPP_REQUIRED=false

# Google Calendar Integration
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=your-base64-encoded-or-escaped-pem-private-key
GOOGLE_CALENDAR_REQUIRED=false

# Email Service (SendGrid)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
